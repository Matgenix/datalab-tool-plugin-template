[build-system]
requires = ["setuptools>=77", "wheel", "setuptools-scm>=8.1,<10"]
build-backend = "setuptools.build_meta"

[project]
name = {{ distribution_name | tojson }}
dynamic = ["version"]
description = {{ description | tojson }}
readme = "README.md"
license = "MIT"
requires-python = ">=3.11,<3.12"
authors = [
    { name = {{ author_name | tojson }}, email = {{ author_email | tojson }} },
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Science/Research",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Topic :: Scientific/Engineering",
]
dependencies = []
{% if tool_ui_kind == "standalone" %}
[project.optional-dependencies]
service = [
    "flask>=3.1,<4",
    "gunicorn>=23,<24",
    "httpx>=0.28,<1",
]
{% endif %}

[project.entry-points."pydatalab.tools"]
{{ tool_id | tojson }} = "{{ distribution_name | replace('-', '_') }}.provider:{{ (tool_id[:-5] if tool_id.endswith('-tool') else tool_id) | replace('-', ' ') | title | replace(' ', '') }}ToolProvider"

[project.urls]
Homepage = "https://{{ repository_namespace }}.github.io/{{ repository_name }}/"
Documentation = "https://{{ repository_namespace }}.github.io/{{ repository_name }}/"
Repository = "https://github.com/{{ repository_namespace }}/{{ repository_name }}"
Changelog = "https://github.com/{{ repository_namespace }}/{{ repository_name }}/releases"

[tool.setuptools.package-data]
{% if tool_ui_kind == "in-app" -%}
{{ distribution_name | replace('-', '_') | tojson }} = ["py.typed", "static/frontend/*.js"]
{% else -%}
{{ distribution_name | replace('-', '_') | tojson }} = ["py.typed", "templates/*.html"]
{% endif %}

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools_scm]
fallback_version = "0.1.0"
version_scheme = "post-release"

[dependency-groups]
dev = [
    "datalab-server[server]",
    "mkdocs>=1.6,<2",
    "mkdocs-material>=9.5,<10",
    "mkdocstrings[python]>=0.30,<1",
    "pre-commit>=4,<5",
    "pytest>=8,<9",
    "pytest-cov>=5,<8",
]

[tool.uv.sources]
datalab-server = { git = "https://github.com/Matgenix/datalab.git", branch = "dw/tools_plugins_nojupyter", subdirectory = "pydatalab" }

[tool.coverage.run]
branch = true
source = ["{{ distribution_name | replace('-', '_') }}"]

[tool.coverage.report]
show_missing = true
skip_covered = true

[tool.mypy]
follow_imports = "skip"
ignore_missing_imports = true
python_version = "3.11"

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "Q", "W", "DTZ", "S", "G"]
ignore = ["E501", "E402"]
per-file-ignores = { "tests/*" = ["S101"] }
